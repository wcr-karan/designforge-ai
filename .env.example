# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://localhost:5432/designforge?schema=public"

# AI Evaluation configuration
# AI_PROVIDER: "mock" (default, deterministic & explainable LLD evaluation), "gemini", or "openai"
AI_PROVIDER="mock"

# Optional AI API keys (required only if AI_PROVIDER is set to "gemini" or "openai")
GEMINI_API_KEY=""
OPENAI_API_KEY=""
